PHIGRAPH_ENV=development
PHIGRAPH_HOST=0.0.0.0
PHIGRAPH_PORT=8000
PHIGRAPH_LOG_LEVEL=INFO
PHIGRAPH_SHADOW_ONLY=true
PHIGRAPH_REAL_CONNECTORS_ENABLED=false
PHIGRAPH_DATA_DIR=data
PHIGRAPH_TRACE_STORE=data/traces.json
PHIGRAPH_SHADOW_STORE=data/shadow_deployment.json
PHIGRAPH_DECISION_AUDIT=data/decision_audit.json
PHIGRAPH_ADVISORY_QUEUE=data/advisory_queue.json
PHIGRAPH_IDEMPOTENCY_STORE=data/execution_idempotency.json
PHIGRAPH_MAX_REQUEST_ROWS=100000
# PHIGRAPH_API_KEY=replace-with-secret

# Zenodo paper upload (scripts/upload_zenodo_paper_v2.py)
# Create at https://zenodo.org/account/settings/applications/new/
# Scopes: deposit:write, deposit:actions
# ZENODO_ACCESS_TOKEN=replace-with-zenodo-token

PHIGRAPH_DATABASE_URL=sqlite:///data/phigraph.db
