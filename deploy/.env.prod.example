# PhiGraph closed-pilot production environment
# Copy to .env on the VPS and fill secrets. Never commit the filled file.

PHIGRAPH_ENV=production
PHIGRAPH_HOST=0.0.0.0
PHIGRAPH_PORT=8000
PHIGRAPH_LOG_LEVEL=INFO

# Hard safety boundary for the pilot (must stay true / false)
PHIGRAPH_SHADOW_ONLY=true
PHIGRAPH_REAL_CONNECTORS_ENABLED=false

PHIGRAPH_DATA_DIR=/app/data
PHIGRAPH_DATABASE_URL=sqlite:////app/data/phigraph.db

# Shared admin/deployment key for /config and legacy shadow routes
PHIGRAPH_API_KEY=replace-with-long-random-admin-key

# Per-client pilot auth: mint one JWT per customer (scripts/mint_pilot_token.py)
PHIGRAPH_JWT_SECRET=replace-with-long-random-jwt-secret
PHIGRAPH_JWT_ISSUER=phigraph-pilot
PHIGRAPH_JWT_AUDIENCE=phigraph-api

# Optional HMAC signing for evidence / receipts
# PHIGRAPH_SIGNING_KEY=replace-with-signing-key

# Rate limit per tenant:subject (requests / window)
PHIGRAPH_RATE_LIMIT=120
PHIGRAPH_RATE_WINDOW_SECONDS=60

# Public URL used by reverse proxy / client docs
PHIGRAPH_PUBLIC_BASE_URL=https://phigraph.phi47.cl

# Caddy TLS (must match the DNS A/AAAA record pointing to the VPS)
PHIGRAPH_DOMAIN=phigraph.phi47.cl
ACME_EMAIL=wcalmels@phi47.cl
