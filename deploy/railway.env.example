# Railway private pilot — copy values into Railway service variables.
# Do not commit real secrets.

PHIGRAPH_ENV=staging
PHIGRAPH_HOST=0.0.0.0
# Railway injects PORT; PHIGRAPH_PORT is optional and falls back to PORT.
PHIGRAPH_BACKEND=postgresql
PHIGRAPH_POSTGRES_DSN=${{Postgres.DATABASE_URL}}
PHIGRAPH_SHADOW_ONLY=true
PHIGRAPH_REAL_CONNECTORS_ENABLED=false
PHIGRAPH_DATA_DIR=/app/data
PHIGRAPH_API_KEY=replace-with-long-random-secret
PHIGRAPH_RECEIPT_SIGNING_KEY=replace-with-long-random-secret
PHIGRAPH_LOG_LEVEL=INFO

# Server-side API key identities (never trust client X-Tenant-ID / X-Subject).
# Option A: JSON registry
# PHIGRAPH_API_KEY_REGISTRY=[{"key":"...","subject":"release-agent","role":"operator","tenant_id":"pilot-b2-tenant-a","project_id":"pilot-b2-project"},{"key":"...","subject":"human-verifier","role":"verifier","tenant_id":"pilot-b2-tenant-a","project_id":"pilot-b2-project"},{"key":"...","subject":"tenant-b-viewer","role":"verifier","tenant_id":"pilot-b2-tenant-b","project_id":"pilot-b2-project"}]
# Option B: pilot preset keys (recommended for block-2 validation)
# PHIGRAPH_API_KEY_PROPOSER=replace-with-proposer-secret
# PHIGRAPH_API_KEY_VERIFIER=replace-with-verifier-secret
# PHIGRAPH_API_KEY_TENANT_B=replace-with-tenant-b-secret
# PHIGRAPH_PILOT_TENANT_A=pilot-b2-tenant-a
# PHIGRAPH_PILOT_TENANT_B=pilot-b2-tenant-b
# PHIGRAPH_PILOT_PROJECT=pilot-b2-project

# Optional symmetric HS256 bearer JWT (not full OIDC/JWKS; use PHIGRAPH_OIDC_* for federated trust)
# PHIGRAPH_JWT_SECRET=replace-with-jwt-hmac-secret
# PHIGRAPH_JWT_ISSUER=phigraph-pilot
# PHIGRAPH_JWT_AUDIENCE=phigraph-api
# PHIGRAPH_OIDC_JWKS_URL=https://issuer.example/.well-known/jwks.json
# PHIGRAPH_OIDC_ISSUER=https://issuer.example
# PHIGRAPH_OIDC_AUDIENCE=phigraph-api

# Optional explicit release/predeploy step:
# python scripts/deploy/bootstrap_postgres_migrations.py
