# Copy to deploy/staging/.env.staging (gitignored). Placeholders only — never commit real values.
# STAGING = NOT_PROVISIONED until an operator creates the VPS and fills this file locally.

# --- PostgreSQL container (docker-compose.grdi-cutover.yml) ---
POSTGRES_DB=REPLACE_WITH_STAGING_DB_NAME
POSTGRES_USER=REPLACE_WITH_STAGING_DB_USER
POSTGRES_PASSWORD=REPLACE_WITH_STAGING_DB_PASSWORD

# --- PhiGraph staging session (operator shell / cutover tooling) ---
# Build from POSTGRES_* after provisioning; keep only on the VPS or in an encrypted secret store.
PHIGRAPH_POSTGRES_DSN=postgresql://REPLACE_WITH_STAGING_DB_USER:REPLACE_WITH_STAGING_DB_PASSWORD@127.0.0.1:5432/REPLACE_WITH_STAGING_DB_NAME

PHIGRAPH_ENVIRONMENT=staging
PHIGRAPH_ENV=staging
PHIGRAPH_SHADOW_ONLY=true
PHIGRAPH_REAL_CONNECTORS_ENABLED=false

# RC7 staging fixture loader: must match scripts/data/grdi_rc7_staging_fixture_rows.json
# Label: rc7-staging-fixture-v1 (synthetic, isolated staging only — not production)
PHIGRAPH_RECEIPT_SIGNING_KEY=grdi-rc7-staging-fixture-key-v1

# Optional API guard (recommended if API is started during smoke tests).
# PHIGRAPH_API_KEY=REPLACE_WITH_STAGING_API_KEY

# Cutover tooling (session-only; never persist in shell profiles).
PHIGRAPH_CUTOVER_ENV=staging
PHIGRAPH_CUTOVER_OPERATOR=REPLACE_WITH_OPERATOR_HANDLE
